{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/rewrite-probe-xyz", "destination": "/certificado.html" },
    { "source": "/certificados/:slug+", "destination": "/certificado.html" },
    { "source": "/membros/:path*", "destination": "/membros/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
